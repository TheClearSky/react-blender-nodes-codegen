{
  "name": "@theclearsky/react-blender-nodes-codegen",
  "version": "0.0.2",
  "type": "module",
  "author": "Deepak Prasad <TheClearSky@github.com>",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheClearSky/react-blender-nodes-codegen.git"
  },
  "homepage": "https://github.com/TheClearSky/react-blender-nodes-codegen",
  "keywords": [
    "react-blender-nodes",
    "codegen",
    "code-generation",
    "graph",
    "runGraph"
  ],
  "description": "Codegen plugin for @theclearsky/react-blender-nodes — compiles a node graph into a standalone, dependency-free runGraph JavaScript/TypeScript module.",
  "files": [
    "dist"
  ],
  "main": "./dist/react-blender-nodes-codegen.umd.cjs",
  "module": "./dist/react-blender-nodes-codegen.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-blender-nodes-codegen.es.js",
      "require": "./dist/react-blender-nodes-codegen.umd.cjs"
    }
  },
  "scripts": {
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/check-dist-types.ts && node --experimental-strip-types scripts/check-dist-loads.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretty": "prettier --write .",
    "pretty:check": "prettier --check .",
    "type-check": "tsc -b",
    "check:docs": "node --experimental-strip-types scripts/check-doc-citations.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:watch": "vitest --watch",
    "demo": "node demo/emit-demo.mjs",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "find-dead-code": "npx knip",
    "ded": "npm run find-dead-code"
  },
  "peerDependencies": {
    "@theclearsky/react-blender-nodes": ">=0.0.14 <1",
    "zod": "^4.1.5"
  },
  "dependencies": {
    "prettier": "^3.6.2",
    "typescript": "~7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@theclearsky/react-blender-nodes": "^0.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.8.4",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "immer": "^11.1.18",
    "knip": "^6.0.1",
    "lint-staged": "^17.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11",
    "zod": "4.5.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "lint-staged": {
    "*.{ts,tsx,md,json,yml,mjs}": [
      "prettier --write"
    ]
  }
}
